cc_library_shared {
    name: "libcamera_graphicbuffer_shim",
    vendor: true,
    compile_multilib: "32",
    srcs: ["camera_graphicbuffer_shim.cpp"],
    shared_libs: ["libui", "libutils"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

java_library {
    name: "sanders-telephony-stub",
    installable: true,
    provides_uses_lib: "sanders-telephony-stub",
    sdk_version: "system_current",
    srcs: [
        "TelephonyBaseUtilsStub.java",
    ],
}
