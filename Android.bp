soong_namespace {
    imports: [
        "hardware/qcom-caf/common/libqti-perfd-client",
        "hardware/qcom-caf/msm8953",
        "vendor/qcom/opensource/display",
    ],
}

install_symlink {
    name: "dsp_symlink",
    vendor: true,
    installed_location: "lib/dsp",
    symlink_target: "/vendor/dsp",
}

install_symlink {
    name: "firmware_mount_symlink",
    vendor: true,
    installed_location: "f",
    symlink_target: "/vendor/firmware_mnt",
}
