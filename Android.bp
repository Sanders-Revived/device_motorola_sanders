soong_namespace {
}

install_symlink {
    name: "dsp_symlink",
    vendor: true,
    installed_location: "lib/dsp",
    symlink_target: "/vendor/dsp",
}

install_symlink {
    name: "firmware_mount_symlink",
    vendor: true,
    installed_location: "f",
    symlink_target: "/vendor/firmware_mnt",
}

cc_library_shared {
    name: "libmmcamera_ppeiscore_shim",
    vendor: true,
    compile_multilib: "32",
    srcs: ["libmmcamera_ppeiscore_shim.cpp"],
    shared_libs: [
        "libui",
    ],
}
